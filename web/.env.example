# Google Sign-In / NextAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
STAFF_ALLOWLIST=staff1@example.com,staff2@example.com

# Google Sheets service account
SHEETS_SERVICE_ACCOUNT_EMAIL=
SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=
SHEETS_SPREADSHEET_ID_CREDITS=
SHEETS_SPREADSHEET_ID_ANALYTICS=

# Wisenet API (Phase 1 discovery; Phase 2 wires lib/wisenet/*)
WISENET_BASE_URL=
WISENET_API_KEY=
WISENET_USER_ID=
WISENET_CENTER_ID=
WISENET_NAMESPACE=begifted-education

# Phase 2 — Neon Postgres via Vercel Marketplace Neon integration
# Auto-injected across prod/preview/dev when the integration is provisioned.
# pooled (PgBouncer) — runtime HTTP + WebSocket clients
DATABASE_URL=
# unpooled (direct) — drizzle-kit migrations only; PgBouncer is incompatible with advisory locks
DATABASE_URL_UNPOOLED=
